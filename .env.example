# Copier en .env et compléter. Le .env est ignoré par git.

# Home Assistant
HA_URL=https://homeassistant.local:8123
HA_TOKEN=token_longue_duree_home_assistant

# Position : Open-Meteo, course du soleil, qualité de l'air
LAT=45.7797
LON=3.0863

# Entités Home Assistant. Une valeur vide désactive le capteur.
EXT_ENTITY=sensor.temperature_exterieure
HUM_ENTITY=sensor.humidite_exterieure
INT_TEMP_ENTITY=sensor.temperature_salon
INT_HUM_ENTITY=sensor.humidite_salon
HA_COR_TEMP=sensor.temperature_chambre
COR_HUM_ENTITY=sensor.humidite_chambre
# Entité affichée sur la page d'accueil (chez l'amont, un template du minimum intérieur)
HA_INTERIOR_TEMP_MIN=sensor.temperature_salon
CO2_ENTITY=
STOVE_POWER_ENTITY=

# Réseau. Les trois ports sont liés à 127.0.0.1. WEB_BIND à l'adresse du serveur
# pour ouvrir l'interface au LAN : /admin n'a pas d'authentification.
WEB_BIND=127.0.0.1
WEB_PORT=8730
ML_PORT=8731
COLLECTOR_PORT=8732

# Fuseau du planificateur
TZ=Europe/Paris

# Capteurs publiés dans Home Assistant
HA_SENSOR_PREFIX=micro_climat
HA_PUBLISH_HORIZON_HOURS=6

# Réglages du moteur. Vide = valeur par défaut (23 °C, 0,5 °C, 0,3 °C).
INT_HOT_THRESHOLD_C=
FAVORABLE_MARGIN_CHAUD=
FAVORABLE_MARGIN_FROID=

# Unraid : icône de l'onglet Docker. Laisser vide ailleurs.
UNRAID_ICON_URL=
