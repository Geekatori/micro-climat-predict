# Copier en .env et compléter. Le .env est ignoré par git.

# Home Assistant
HA_URL=https://homeassistant.local:8123
HA_TOKEN=token_longue_duree_home_assistant
HA_HOST=

# Position (pour Open-Meteo et la course du soleil)
LAT=45.7797
LON=3.0863

# Ports exposés sur 127.0.0.1 uniquement.
# Volontairement hors des plages courantes (8000/8080/8443) pour éviter les collisions.
WEB_PORT=8730
# Adresse d'écoute de l'interface web. 127.0.0.1 pour un usage local ; l'adresse du
# serveur pour la rendre joignable depuis le LAN. Moteur et collecteur restent
# volontairement sur la boucle locale.
WEB_BIND=127.0.0.1
ML_PORT=8731
COLLECTOR_PORT=8732

# Fuseau du planificateur (entraînement nocturne)
TZ=Europe/Paris

# Entités Home Assistant. Une valeur vide désactive le capteur.
EXT_ENTITY=sensor.temperature_exterieure
HUM_ENTITY=sensor.humidite_exterieure
INT_TEMP_ENTITY=sensor.temperature_salon
INT_HUM_ENTITY=sensor.humidite_salon
HA_COR_TEMP=sensor.temperature_chambre
COR_HUM_ENTITY=sensor.humidite_chambre
HA_INTERIOR_TEMP_MIN=sensor.temperature_salon
CO2_ENTITY=
PM25_ENTITY=
PM10_ENTITY=

# Icône affichée dans l'onglet Docker d'Unraid (labels net.unraid.docker.icon).
# Laisser vide en dehors d'Unraid. Voir l'en-tête de docker-compose.yml.
UNRAID_ICON_URL=
